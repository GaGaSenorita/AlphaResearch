+def _daily_metrics_error(payload):
+    """Return a reason when a child result is unsafe to expose as success."""
+    if not isinstance(payload, dict):
+        return "FFO child returned a non-dictionary payload"
+    if not payload.get("success"):
+        return str(payload.get("error") or "FFO child reported failure")
+    rows = payload.get("daily_metrics")
+    if not isinstance(rows, list) or not rows:
+        return "FFO child returned no daily IC/RankIC observations"
+    dates = []
+    for row in rows:
+        if not isinstance(row, dict) or not row.get("date"):
+            return "FFO child returned a malformed daily observation"
+        try:
+            ic = float(row["ic"])
+            rank_ic = float(row["rank_ic"])
+        except (KeyError, TypeError, ValueError):
+            return "FFO child returned a daily observation without numeric IC/RankIC"
+        if not math.isfinite(ic) or not math.isfinite(rank_ic):
+            return "FFO child returned non-finite daily IC/RankIC"
+        dates.append(str(row["date"])[:10])
+    if len(dates) != len(set(dates)):
+        return "FFO child returned duplicate trading dates"
+    return None
 
 
