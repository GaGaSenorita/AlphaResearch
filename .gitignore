# Results file
results.tsv

# Runtime outputs are ignored by default. These three recovered, verified R100
# continual-discovery runs are intentionally versioned under their canonical
# original run names.
runs/*
!runs/ldm_continuous_discovery/
runs/ldm_continuous_discovery/*
!runs/ldm_continuous_discovery/README.md
!runs/ldm_continuous_discovery/results_summary.json
!runs/ldm_continuous_discovery/factor_library/
!runs/ldm_continuous_discovery/factor_library/**
!runs/ldm_continuous_discovery/ldm_continuous_discovery_openai-deepseek-v4-pro_2016-2025_seed42/
!runs/ldm_continuous_discovery/ldm_continuous_discovery_openai-deepseek-v4-pro_2016-2025_seed42/**
!runs/ldm_continuous_discovery/ldm_continuous_discovery_openai-deepseek-v4-pro_2016-2025_seed123/
!runs/ldm_continuous_discovery/ldm_continuous_discovery_openai-deepseek-v4-pro_2016-2025_seed123/**
!runs/ldm_continuous_discovery/ldm_continuous_discovery_openai-deepseek-v4-pro_2016-2025_seed456/
!runs/ldm_continuous_discovery/ldm_continuous_discovery_openai-deepseek-v4-pro_2016-2025_seed456/**

# Stage II methods stay versioned; generated records are local-only.
# Their default destination is ../AlphaResearch_local_results/stage2/.
/local_results/

# One canonical PDF per plot; alternate formats remain local-only.
/figures/**/*.png
/figures/**/*.svg
/runs/ldm_continuous_discovery/*/figure.*
*.zip

.vscode
.DS_Store
logs/
